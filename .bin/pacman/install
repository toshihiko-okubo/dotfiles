  pavucontrol \
  ripgrep \
  sysstat \
  tmux \
  unzip \
  vim \
  wget \
  zsh \
  zsh-autosuggestions \
  zsh-completions \
  zsh-syntax-highlighting

# AUR パッケージ
yay -S --needed --noconfirm \
  dua-cli \
  ghq \
  git-secrets \
