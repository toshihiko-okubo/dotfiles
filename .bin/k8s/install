#!/usr/bin/env bash

set -eu

# kubectl
sudo pacman -S --needed --noconfirm kubectl
kubectl version --client

# helm
sudo pacman -S --needed --noconfirm helm
helm version

# k9s
sudo pacman -S --needed --noconfirm k9s
k9s version
k9s completion fish > ~/.config/fish/completions/k9s.fish

# kustomize / stern / kubectx / kube-ps1 / kind / argocd / argo (AUR)
yay -S --needed --noconfirm \
  kustomize \
  stern \
  kubectx \
  kube-ps1 \
  kind \
  argocd \
  argo
