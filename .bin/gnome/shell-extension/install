#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(cd $(dirname "$0"); pwd)

sudo apt install -y gnome-shell-extension-manager gnome-shell-extension-prefs

LIST_FILE="${1:-${SCRIPT_DIR}/extensions.txt}"

if [[ ! -f "$LIST_FILE" ]]; then
  echo "List file not found: $LIST_FILE" >&2
  echo "Usage: $0 extensions.txt" >&2
  exit 1
fi

# gext の用意（pipx 推奨。pipx が無ければ apt で入れる）
if ! command -v gext >/dev/null 2>&1; then
  if command -v pipx >/dev/null 2>&1; then
    pipx install gnome-extensions-cli
  else
    echo "gext not found. Install pipx (recommended) or install gext another way." >&2
    echo "  Ubuntu: sudo apt -y install pipx && pipx ensurepath && pipx install gnome-extensions-cli" >&2
    exit 1
  fi
fi

# UUID リストを整形（空行・コメント除外）
mapfile -t UUIDS < <(grep -vE '^\s*($|#)' "$LIST_FILE" | tr -d '\r')

if [[ "${#UUIDS[@]}" -eq 0 ]]; then
  echo "No UUIDs found in $LIST_FILE" >&2
  exit 1
fi

# 既にインストール済みのものはスキップ（ユーザー領域）
EXT_DIR="$HOME/.local/share/gnome-shell/extensions"
mkdir -p "$EXT_DIR"

TO_INSTALL=()
for uuid in "${UUIDS[@]}"; do
  if [[ -d "$EXT_DIR/$uuid" ]]; then
    echo "SKIP (already installed): $uuid"
  else
    TO_INSTALL+=("$uuid")
  fi
done

if [[ "${#TO_INSTALL[@]}" -eq 0 ]]; then
  echo "Nothing to install."
  exit 0
fi

echo "Installing ${#TO_INSTALL[@]} extensions via gext..."
# gext は UUID を複数渡して一括 install できる :contentReference[oaicite:2]{index=2}
gext install "${TO_INSTALL[@]}"

echo "Done."
echo "Next (optional): enable extensions with 'gnome-extensions enable <UUID>'"
